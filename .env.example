# Frontend. Use the local authenticated API for server-side accounts and projects.
VITE_API_BASE_URL=http://127.0.0.1:3000
# Leave blank: analysis is triggered and tracked by the authenticated API above.
VITE_PROJECTMENTOR_AI_BACKEND_URL=

# Backend only. Keep the provider key out of all VITE_ variables.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
LLM_TIMEOUT_MS=60000
JWT_SECRET=
DB_PATH=server/data/projectmentor.sqlite
